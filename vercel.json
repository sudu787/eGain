{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "excludeFiles": "{tests/**,submission/**,website/**,data/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/healthz",
      "destination": "/api/index.py/healthz"
    },
    {
      "source": "/docs",
      "destination": "/api/index.py/docs"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index.py/openapi.json"
    }
  ]
}
