# Set this to the exact published eGain demo origin when configuring browser access.
# Leave blank when the eGain action calls the API server-to-server.
GRIDGUIDE_ALLOWED_ORIGINS=
GRIDGUIDE_DB_PATH=./data/gridguide.sqlite3
# For cloud deployment, use a managed Postgres connection string instead.
GRIDGUIDE_DATABASE_URL=
# Set a long random bearer token for the hosted action endpoint.
GRIDGUIDE_API_KEY=
